# Offline-built control-plane image. The caller supplies the staged app
# directory from deploy/offline/build-offline.sh as the build context.
FROM teams-bridge:0.2.0
WORKDIR /app
COPY . /app
ENV NODE_ENV=production
ENV SIRIUSX_DB=/data/control.sqlite
ENV SIRIUSX_DATA_DIR=/data
EXPOSE 4320 4321 4322
VOLUME ["/data"]
CMD ["node", "--import", "tsx", "apps/control-plane/src/cli.ts", "serve", "--db", "/data/control.sqlite", "--data-dir", "/data", "--host", "0.0.0.0", "--port", "4320", "--gateway-port", "4321", "--device-port", "4322"]
