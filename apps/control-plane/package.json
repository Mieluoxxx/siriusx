    "@siriusx/executor-local": "workspace:*",
    "@siriusx/fake-kernel": "workspace:*",
    "@siriusx/kernel-acp": "workspace:*",
    "@siriusx/storage": "workspace:*",
    "jose": "6.2.17",
    "ws": "8.18.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
