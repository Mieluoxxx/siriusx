{
  "name": "@siriusx/dsh-executor-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DSH Host plugin exposing the SiriusX local Executor (local_dir) inside the Host.",
  "license": "MIT",
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "files": ["dist/index.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": ["./cordis.patch.yml"]
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --external:@deepseek-ai/*",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@siriusx/contracts": "workspace:*",
    "@siriusx/executor-local": "workspace:*",
    "@siriusx/kernel-api": "workspace:*",
    "@siriusx/kernel-dsh": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
