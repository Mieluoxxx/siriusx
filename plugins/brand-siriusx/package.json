{
  "name": "@siriusx/dsh-client-brand",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SiriusX desktop brand occupants; replaces the official brand plugin.",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json" },
  "files": ["lib/index.js", "lib/client.js", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": { "patch": ["./cordis.patch.yml"] },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-renderer", "@deepseek-ai/dsh-client-ui-sidebar"],
      "platform": "web"
    }
  },
  "scripts": { "build": "node scripts/build.mjs", "typecheck": "tsc -p tsconfig.json --noEmit" },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.1",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "react": "18.3.1",
    "typescript": "6.0.3"
  }
}
