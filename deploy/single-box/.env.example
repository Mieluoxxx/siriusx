SIRIUSX_ADMIN_WEB_IMAGE=siriusx/admin-web:offline
SIRIUSX_MODEL_ROUTER_IMAGE=siriusx/model-router:offline
SIRIUSX_MODEL_ROUTER_KEY=sk-siriusx-router
SIRIUSX_SECRETS_KEY=replace-with-a-long-random-secret
# Set DATABASE_URL to enable the PostgreSQL hybrid storage mode.
# DATABASE_URL=postgres://siriusx:change-me@postgres:5432/siriusx
SIRIUSX_CACHE_REFRESH_MS=30000
SIRIUSX_SESSION_SECRET=replace-with-at-least-32-random-bytes
SIRIUSX_PLATFORM_ADMIN_TOKEN=replace-with-a-platform-admin-token
SIRIUSX_SOURCE_WEBHOOK_TOKEN=replace-with-a-source-webhook-token
SIRIUSX_GITHUB_WEBHOOK_SECRET=replace-with-a-github-webhook-secret
SIRIUSX_UPSTREAM_MODEL_URL=
SIRIUSX_UPSTREAM_MODEL_KEY=
