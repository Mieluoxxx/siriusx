{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "uploads": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "uploadId": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string"
          },
          "storedPath": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "uploadId",
          "sourcePath",
          "storedPath",
          "size"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "uploads"
  ],
  "additionalProperties": false
}
