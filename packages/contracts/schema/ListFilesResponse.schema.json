{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "file",
              "dir",
              "symlink"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "modified": {
            "type": "boolean"
          },
          "ignored": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "path",
          "type",
          "modified",
          "ignored",
          "sensitive"
        ],
        "additionalProperties": false
      }
    },
    "nextCursor": {
      "type": "string"
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
