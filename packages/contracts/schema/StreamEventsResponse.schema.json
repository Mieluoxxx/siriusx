{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "state"
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "preparing",
                  "running",
                  "backgrounded",
                  "reported",
                  "cancelled",
                  "lost"
                ]
              }
            },
            "required": [
              "type",
              "seq",
              "at",
              "state"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "report"
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "report": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "ready"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "changeRequest": {
                        "type": "object",
                        "properties": {
                          "provider": {
                            "type": "string",
                            "enum": [
                              "gitlab",
                              "github"
                            ]
                          },
                          "number": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
                          },
                          "url": {
                            "type": "string",
                            "format": "uri"
                          }
                        },
                        "required": [
                          "provider",
                          "number",
                          "url"
                        ],
                        "additionalProperties": false
                      },
                      "diffStats": {
                        "type": "object",
                        "properties": {
                          "filesChanged": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "insertions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "deletions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "filesChanged",
                          "insertions",
                          "deletions"
                        ],
                        "additionalProperties": false
                      },
                      "diffBasis": {
                        "type": "string",
                        "enum": [
                          "baseRef",
                          "ticketStart",
                          "none"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "diffStats",
                      "diffBasis"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "answer"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "question": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "question"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "blocked"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "failed"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "reason"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "waiting"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "kind",
                      "summary",
                      "reason"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "type",
              "seq",
              "at",
              "report"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "log"
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "stream": {
                "type": "string",
                "enum": [
                  "stdout",
                  "stderr",
                  "agent"
                ]
              },
              "chunk": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "seq",
              "at",
              "stream",
              "chunk"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "activity"
              },
              "seq": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "tool",
                  "model"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "nameClass": {
                "type": "string",
                "enum": [
                  "builtin",
                  "custom"
                ]
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "resultClass": {
                "type": "string",
                "enum": [
                  "ok",
                  "error",
                  "denied",
                  "timeout",
                  "cancelled"
                ]
              },
              "inputBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "outputBytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "usage": {
                "type": "object",
                "properties": {
                  "inputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "outputTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "cachedTokens": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "inputTokens",
                  "outputTokens"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "type",
              "seq",
              "at",
              "kind",
              "name",
              "nameClass",
              "durationMs",
              "resultClass"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "logsTruncated": {
      "type": "boolean"
    },
    "oldestLogSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "events",
    "logsTruncated"
  ],
  "additionalProperties": false
}
