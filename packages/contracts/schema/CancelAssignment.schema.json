{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "assignmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "graceful",
        "kill"
      ]
    },
    "reason": {
      "type": "string",
      "enum": [
        "user_interrupted",
        "user_stop",
        "mandate_revoked",
        "operator"
      ]
    },
    "clientContext": {
      "type": "object",
      "properties": {
        "operatorId": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "enum": [
            "gitlab",
            "github",
            "feishu",
            "teams",
            "app",
            "cli",
            "system"
          ]
        },
        "deviceId": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "enum": [
            "web",
            "desktop",
            "mobile"
          ]
        }
      },
      "required": [
        "operatorId",
        "channel"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "tenantId",
    "assignmentId",
    "mode",
    "reason",
    "clientContext"
  ],
  "additionalProperties": false
}
