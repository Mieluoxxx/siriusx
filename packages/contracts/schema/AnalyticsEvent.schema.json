{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "schema": {
      "type": "string",
      "enum": [
        "trigger.received",
        "eval.decided",
        "ticket.stage_changed",
        "assignment.state_changed",
        "model.called",
        "tool.called",
        "gateway.decided",
        "human.input",
        "report.produced",
        "outcome.recorded"
      ]
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "botId": {
      "type": "string",
      "minLength": 1
    },
    "ticketId": {
      "type": "string",
      "minLength": 1
    },
    "assignmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "traceId": {
      "type": "string",
      "minLength": 1
    },
    "spanId": {
      "type": "string",
      "minLength": 1
    },
    "parentSpanId": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "bot",
        "gateway",
        "model-gateway",
        "executor",
        "app"
      ]
    },
    "workspaceKind": {
      "type": "string",
      "enum": [
        "cloud_project",
        "local_dir"
      ]
    },
    "variant": {
      "type": "object",
      "properties": {
        "promptVersion": {
          "type": "string",
          "minLength": 1
        },
        "policyVersion": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "kernel": {
          "type": "string",
          "minLength": 1
        },
        "kernelVersion": {
          "type": "string",
          "minLength": 1
        },
        "featureFlags": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string"
              },
              {
                "type": "number"
              }
            ]
          }
        }
      },
      "required": [
        "promptVersion",
        "policyVersion",
        "model",
        "kernel",
        "kernelVersion",
        "featureFlags"
      ],
      "additionalProperties": false
    },
    "payload": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "eventId",
    "schema",
    "schemaVersion",
    "occurredAt",
    "seq",
    "tenantId",
    "botId",
    "ticketId",
    "traceId",
    "spanId",
    "source",
    "variant",
    "payload"
  ],
  "additionalProperties": false
}
